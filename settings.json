{
    "window.zoomLevel": 3,
    "window.commandCenter": false,
    "workbench.activityBar.location": "top",
    "workbench.sideBar.location": "right",
    "workbench.statusBar.visible": false,
    "workbench.startupEditor": "none",
    "workbench.tips.enabled": false,
    "workbench.layoutControl.enabled": false,
    "workbench.editor.showTabs": "none",
    "workbench.editor.showIcons": false,
    "workbench.editor.empty.hint": "hidden",
    "breadcrumbs.enabled": false,
    "terminal.integrated.allowChords": false,
    "workbench.panel.opensMaximized": "never",
    "accessibility.verbosity.terminal": false,

    "editor.lineNumbers": "relative",
    "editor.minimap.enabled": false,
    "editor.stickyScroll.enabled": false,
    "editor.codeLens": false,
    "editor.links": false,
    "editor.glyphMargin": false,
    "editor.showFoldingControls": "mouseover",
    "editor.smoothScrolling": true,
    "editor.fastScrollSensitivity": 5,
    "editor.mouseWheelScrollSensitivity": 1.5,
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.vertical": "hidden",

    "editor.cursorStyle": "block",
    "editor.cursorBlinking": "solid",
    "editor.cursorSmoothCaretAnimation": "on",

    "editor.fontFamily": "JetBrains Mono",
    "editor.fontSize": 11,
    "editor.fontWeight": "bold",
    "editor.lineHeight": 1.5,
    "editor.letterSpacing": 0.3,
    "editor.fontLigatures": "'calt', 'ss01', 'ss02', 'ss19', 'ss20'",
    "terminal.integrated.smoothScrolling": true,
    "editor.renderWhitespace": "none",
    "workbench.list.smoothScrolling": true,

    "editor.matchBrackets": "never",
    "editor.occurrencesHighlight": "off",
    "editor.overviewRulerBorder": false,
    "editor.hideCursorInOverviewRuler": true,
    "editor.parameterHints.enabled": false,
    "editor.hover.enabled": "off",
    "editor.renderLineHighlight": "none",
    "editor.guides.indentation": false,
    "editor.suggestOnTriggerCharacters": false,
    "editor.tabCompletion": "on",
    "editor.quickSuggestions": {
        "other": "off",
        "comments": "off",
        "strings": "off"
    },

    "workbench.tree.renderIndentGuides": "none",
    "workbench.tree.indent": 16,
    "explorer.compactFolders": false,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmPasteNative": false,
    "search.decorations.badges": false,

    "files.autoSave": "afterDelay",
    "git.decorations.enabled": false,
    "scm.diffDecorations": "none",
    "python.createEnvironment.trigger": "off",
    "security.workspace.trust.untrustedFiles": "open",

    "editor.unicodeHighlight.allowedLocales": { "ru": true },
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.nonBasicASCII": false,

    "workbench.colorTheme": "Kanso Ink",
    "workbench.iconTheme": "material-icon-theme",
        "workbench.colorCustomizations": {
        "editor.background": "#161616",
        "sideBar.background": "#161616",
        "activityBar.background": "#161616",
        "titleBar.activeBackground": "#161616",
        "titleBar.inactiveBackground": "#161616",
        "panel.background": "#161616",
        "terminal.background": "#161616",
        "editorGroupHeader.noTabsBackground": "#161616",
        "editorGroupHeader.tabsBackground": "#161616", 
        "editorGroupHeader.border": "#00000000",
        "editor.lineHighlightBackground": "#00000000",
        "sideBar.border": "#00000000",
        "activityBar.border": "#00000000",
        "panel.border": "#00000000",
        "editorGroup.border": "#00000000",
        "scrollbar.shadow": "#00000000",
        "scrollbarSlider.background": "#00000000", 
        "scrollbarSlider.hoverBackground": "#00000000",
        "scrollbarSlider.activeBackground": "#00000000"
    },

    "liveServer.settings.donotVerifyTags": true,
    "terminal.integrated.fontFamily": "monospace",
    "window.menuBarVisibility": "compact",
    "claudeCode.preferredLocation": "panel",
    "mcpServers": {}
}
